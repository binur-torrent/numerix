# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. These emails are promoted to admin when SUPABASE_SERVICE_ROLE_KEY is set.
# Otherwise, after the first sign-up, run:
#   update public.profiles set role = 'admin' where email = 'you@example.com';
ADMIN_EMAILS=

# Optional. Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=
