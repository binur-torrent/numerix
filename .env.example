# Supabase → Project Settings → API keys
# The publishable key starts with sb_publishable_ (or the older anon public key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. The secret key starts with sb_secret_. Never use a NEXT_PUBLIC_ name for it.
# Needed only to promote ADMIN_EMAILS. You can also set admin with SQL.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Comma-separated emails promoted to admin on sign-in.
ADMIN_EMAILS=
